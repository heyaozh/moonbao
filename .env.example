# 至少填一个 LLM key
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 角色名（候选：小满 / 皎皎）；前后端共用，人格文件里的 {{NAME}} 由它替换
CHARACTER_NAME=小满

# LLM：claude（默认）| openai
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o

# 它默认不说话（文字气泡 / 星星拼字）。真人声是可选项：none | edge | openai
TTS_PROVIDER=none
# EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
# OPENAI_TTS_VOICE=coral

# 语音输入（麦克风 → 本地 whisper.cpp），可选：on | off
VOICE_INPUT=off
# WHISPER_BIN=whisper-server
# WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_LANG=zh
# WHISPER_PORT=8790

# 记忆
MEMORY_DB=data/memory.db
# 每天最多主动开口几次（频控铁律）
PROACTIVE_DAILY_CAP=2
# 离开多少天算"久别"
RETURN_AFTER_DAYS=3

MOONBAO_PORT=8787
